# A pasted copy of packages/web/dist used to inspect the packaged window by hand.
# Nothing in the build reads it: electron-builder ships ../../packages/web/dist
# into resources/web (see packages/desktop/electron-builder.yml.js).
packages/desktop/web/

# Tool session state (worktrees, transcripts) — never part of the source tree
.claude/

# A checkout of the release repository, not part of this one
fabric/
