{
  "name": "agent-fabric",
  "version": "0.1.0",
  "private": true,
  "description": "AgentFabric — Run any agent, on any model, in any environment.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "sh -c 'trap \"kill 0\" INT TERM EXIT; npm run build:watch -w @agentfabric/web & npm run dev -w @agentfabric/server; wait'",
    "dev:server": "npm run dev -w @agentfabric/server",
    "dev:web": "npm run dev -w @agentfabric/web",
    "build:web": "npm run build -w @agentfabric/web",
    "desktop": "npm run start -w @agentfabric/desktop",
    "desktop:app": "npm run dist:mac -w @agentfabric/desktop -- --dir",
    "desktop:dmg": "npm run dist:mac -w @agentfabric/desktop",
    "desktop:install": "npm run install:mac -w @agentfabric/desktop --",
    "desktop:verify": "npm run verify:ui -w @agentfabric/desktop",
    "start": "npm run start -w @agentfabric/server",
    "cli": "npm run cli -w @agentfabric/cli --",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "node scripts/fix-node-pty.js",
    "desktop:perf": "npm run perf -w @agentfabric/desktop",
    "desktop:verify:empty": "npm run verify:ui:empty -w @agentfabric/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
